generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model address {
  id             String           @id
  clientId       String
  type           address_type     @default(HOME)
  addressLine1   String
  addressLine2   String?
  city           String
  state          String
  postalCode     String
  country        String
  latitude       Float?
  longitude      Float?
  isDefault      Boolean          @default(false)
  client         client           @relation(fields: [clientId], references: [id], onDelete: Cascade, map: "Address_clientId_fkey")
  servicebooking servicebooking[]

  @@index([clientId], map: "Address_clientId_fkey")
}

model availability {
  id                String          @id
  serviceProviderId String
  dayOfWeek         Int
  startTime         String
  endTime           String
  isAvailable       Boolean         @default(true)
  serviceprovider   serviceprovider @relation(fields: [serviceProviderId], references: [id], onDelete: Cascade, map: "Availability_serviceProviderId_fkey")

  @@index([serviceProviderId], map: "Availability_serviceProviderId_fkey")
}

model category {
  id             String           @id
  name           String           @unique(map: "Category_name_key")
  description    String?          @db.Text
  imageUrl       String?
  service        service[]
  servicerequest servicerequest[]
}

model client {
  id             String           @id
  userId         String           @unique(map: "Client_userId_key")
  address        address[]
  user           user             @relation(fields: [userId], references: [id], onDelete: Cascade, map: "Client_userId_fkey")
  servicebooking servicebooking[]
  servicerequest servicerequest[]
}

model contract {
  id               String               @id
  serviceBookingId String               @unique(map: "Contract_serviceBookingId_key")
  terms            String               @db.Text
  paymentAmount    Decimal              @db.Decimal(10, 2)
  paymentType      contract_paymentType @default(HOURLY)
  clientSigned     Boolean              @default(false)
  providerSigned   Boolean              @default(false)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime
  servicebooking   servicebooking       @relation(fields: [serviceBookingId], references: [id], onDelete: Cascade, map: "Contract_serviceBookingId_fkey")
}

model conversation {
  id                              String          @id
  user1Id                         String
  user2Id                         String
  serviceBookingId                String?         @unique(map: "Conversation_serviceBookingId_key")
  createdAt                       DateTime        @default(now())
  updatedAt                       DateTime
  servicebooking                  servicebooking? @relation(fields: [serviceBookingId], references: [id], map: "Conversation_serviceBookingId_fkey")
  user_conversation_user1IdTouser user            @relation("conversation_user1IdTouser", fields: [user1Id], references: [id], onDelete: Cascade, map: "Conversation_user1Id_fkey")
  user_conversation_user2IdTouser user            @relation("conversation_user2IdTouser", fields: [user2Id], references: [id], onDelete: Cascade, map: "Conversation_user2Id_fkey")
  message                         message[]

  @@unique([user1Id, user2Id], map: "Conversation_user1Id_user2Id_key")
  @@index([user2Id], map: "Conversation_user2Id_fkey")
}

model document {
  id                String          @id
  serviceProviderId String
  title             String
  type              document_type
  fileUrl           String
  isVerified        Boolean         @default(false)
  uploadedAt        DateTime        @default(now())
  serviceprovider   serviceprovider @relation(fields: [serviceProviderId], references: [id], onDelete: Cascade, map: "Document_serviceProviderId_fkey")

  @@index([serviceProviderId], map: "Document_serviceProviderId_fkey")
}

model education {
  id                  String          @id
  serviceProviderId   String
  institution         String
  degree              String
  fieldOfStudy        String?
  startDate           DateTime
  endDate             DateTime?
  isCurrentlyStudying Boolean         @default(false)
  serviceprovider     serviceprovider @relation(fields: [serviceProviderId], references: [id], onDelete: Cascade, map: "Education_serviceProviderId_fkey")

  @@index([serviceProviderId], map: "Education_serviceProviderId_fkey")
}

model location {
  id                String          @id
  serviceProviderId String          @unique(map: "Location_serviceProviderId_key")
  latitude          Float
  longitude         Float
  lastUpdated       DateTime        @default(now())
  serviceprovider   serviceprovider @relation(fields: [serviceProviderId], references: [id], onDelete: Cascade, map: "Location_serviceProviderId_fkey")
}

model message {
  id                            String       @id
  senderId                      String
  receiverId                    String
  content                       String       @db.Text
  isRead                        Boolean      @default(false)
  createdAt                     DateTime     @default(now())
  conversationId                String
  imageUrl                      String?
  conversation                  conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade, map: "Message_conversationId_fkey")
  user_message_receiverIdTouser user         @relation("message_receiverIdTouser", fields: [receiverId], references: [id], onDelete: Cascade, map: "Message_receiverId_fkey")
  user_message_senderIdTouser   user         @relation("message_senderIdTouser", fields: [senderId], references: [id], onDelete: Cascade, map: "Message_senderId_fkey")

  @@index([conversationId], map: "Message_conversationId_fkey")
  @@index([receiverId], map: "Message_receiverId_fkey")
  @@index([senderId], map: "Message_senderId_fkey")
}

model notification {
  id         String            @id
  receiverId String
  type       notification_type
  title      String
  message    String            @db.Text
  isRead     Boolean           @default(false)
  data       String?           @db.Text
  createdAt  DateTime          @default(now())
  user       user              @relation(fields: [receiverId], references: [id], onDelete: Cascade, map: "Notification_receiverId_fkey")

  @@index([receiverId], map: "Notification_receiverId_fkey")
}

model payment {
  id               String         @id
  serviceBookingId String         @unique(map: "Payment_serviceBookingId_key")
  amount           Decimal        @db.Decimal(10, 2)
  status           payment_status @default(PENDING)
  paymentMethod    String?
  transactionId    String?
  paymentDate      DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime
  paymentProofUrl  String?
  servicebooking   servicebooking @relation(fields: [serviceBookingId], references: [id], onDelete: Cascade, map: "Payment_serviceBookingId_fkey")
}

model portfolio {
  id                String          @id
  serviceProviderId String
  title             String
  description       String?         @db.Text
  projectUrl        String?
  createdAt         DateTime        @default(now())
  serviceprovider   serviceprovider @relation(fields: [serviceProviderId], references: [id], onDelete: Cascade, map: "Portfolio_serviceProviderId_fkey")
  portfoliofile     portfoliofile[]

  @@index([serviceProviderId], map: "Portfolio_serviceProviderId_fkey")
}

model portfoliofile {
  id          String    @id
  portfolioId String
  fileUrl     String
  fileName    String?
  fileType    String?
  uploadedAt  DateTime  @default(now())
  portfolio   portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade, map: "PortfolioFile_portfolioId_fkey")

  @@index([portfolioId], map: "PortfolioFile_portfolioId_fkey")
}

model proposal {
  id                String               @id
  serviceRequestId  String
  serviceProviderId String
  serviceId         String
  message           String               @db.Text
  price             Decimal              @db.Decimal(10, 2)
  pricingType       proposal_pricingType @default(HOURLY)
  availableDate     DateTime?
  estimatedDuration Int?
  status            proposal_status      @default(PENDING)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime
  service           service              @relation(fields: [serviceId], references: [id], map: "Proposal_serviceId_fkey")
  serviceprovider   serviceprovider      @relation(fields: [serviceProviderId], references: [id], map: "Proposal_serviceProviderId_fkey")
  servicerequest    servicerequest       @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade, map: "Proposal_serviceRequestId_fkey")

  @@index([serviceId], map: "Proposal_serviceId_fkey")
  @@index([serviceProviderId], map: "Proposal_serviceProviderId_fkey")
  @@index([serviceRequestId], map: "Proposal_serviceRequestId_fkey")
}

model resetpasswordtoken {
  id        String   @id
  userId    String
  token     String   @unique(map: "ResetPasswordToken_token_key")
  expiresAt DateTime
  createdAt DateTime @default(now())
  isUsed    Boolean  @default(false)
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "ResetPasswordToken_userId_fkey")

  @@index([userId], map: "ResetPasswordToken_userId_fkey")
}

model review {
  id                           String          @id
  rating                       Float
  comment                      String?         @db.Text
  createdAt                    DateTime        @default(now())
  giverId                      String
  receiverId                   String
  imageUrls                    String?         @db.Text
  serviceBookingId             String?
  user_review_giverIdTouser    user            @relation("review_giverIdTouser", fields: [giverId], references: [id], onDelete: Cascade, map: "Review_giverId_fkey")
  user_review_receiverIdTouser user            @relation("review_receiverIdTouser", fields: [receiverId], references: [id], onDelete: Cascade, map: "Review_receiverId_fkey")
  servicebooking               servicebooking? @relation(fields: [serviceBookingId], references: [id], map: "Review_serviceBookingId_fkey")

  @@index([giverId], map: "Review_giverId_fkey")
  @@index([receiverId], map: "Review_receiverId_fkey")
  @@index([serviceBookingId], map: "Review_serviceBookingId_fkey")
}

model service {
  id                String              @id
  serviceProviderId String
  title             String
  description       String              @db.Text
  categoryId        String
  pricing           Decimal             @db.Decimal(10, 2)
  pricingType       service_pricingType @default(HOURLY)
  imageUrls         String?             @db.Text
  isActive          Boolean             @default(true)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime
  proposal          proposal[]
  category          category            @relation(fields: [categoryId], references: [id], map: "Service_categoryId_fkey")
  serviceprovider   serviceprovider     @relation(fields: [serviceProviderId], references: [id], onDelete: Cascade, map: "Service_serviceProviderId_fkey")
  servicebooking    servicebooking[]
  skill             skill[]             @relation("servicetoskill")

  @@index([categoryId], map: "Service_categoryId_fkey")
  @@index([serviceProviderId], map: "Service_serviceProviderId_fkey")
}

model servicebooking {
  id                String                @id
  clientId          String
  serviceProviderId String
  serviceId         String
  startTime         DateTime
  endTime           DateTime?
  totalHours        Float?
  status            servicebooking_status @default(PENDING)
  totalAmount       Decimal?              @db.Decimal(10, 2)
  notes             String?               @db.Text
  title             String?
  description       String?               @db.Text
  createdAt         DateTime              @default(now())
  updatedAt         DateTime
  addressId         String?
  serviceRequestId  String?
  contract          contract?
  conversation      conversation?
  payment           payment?
  review            review[]
  address           address?              @relation(fields: [addressId], references: [id], map: "ServiceBooking_addressId_fkey")
  client            client                @relation(fields: [clientId], references: [id], map: "ServiceBooking_clientId_fkey")
  service           service               @relation(fields: [serviceId], references: [id], map: "ServiceBooking_serviceId_fkey")
  serviceprovider   serviceprovider       @relation(fields: [serviceProviderId], references: [id], map: "ServiceBooking_serviceProviderId_fkey")
  servicerequest    servicerequest?       @relation(fields: [serviceRequestId], references: [id], map: "ServiceBooking_serviceRequestId_fkey")
  timerecord        timerecord[]

  @@index([addressId], map: "ServiceBooking_addressId_fkey")
  @@index([clientId], map: "ServiceBooking_clientId_fkey")
  @@index([serviceId], map: "ServiceBooking_serviceId_fkey")
  @@index([serviceProviderId], map: "ServiceBooking_serviceProviderId_fkey")
  @@index([serviceRequestId], map: "ServiceBooking_serviceRequestId_fkey")
}

model serviceprovider {
  id                 String           @id
  userId             String           @unique(map: "ServiceProvider_userId_key")
  bio                String?          @db.Text
  headline           String?
  hourlyRate         Decimal?         @db.Decimal(10, 2)
  rating             Float?           @default(0)
  isProviderVerified Boolean          @default(false)
  availability       availability[]
  document           document[]
  education          education[]
  location           location?
  portfolio          portfolio[]
  proposal           proposal[]
  service            service[]
  servicebooking     servicebooking[]
  user               user             @relation(fields: [userId], references: [id], onDelete: Cascade, map: "ServiceProvider_userId_fkey")
  workexperience     workexperience[]
  skill              skill[]          @relation("serviceprovidertoskill")
}

model servicerequest {
  id             String                    @id
  clientId       String
  title          String
  description    String                    @db.Text
  categoryId     String
  budget         Decimal?                  @db.Decimal(10, 2)
  budgetType     servicerequest_budgetType @default(FIXED)
  location       String?
  date           DateTime?
  startTime      String?
  duration       Int?
  deadline       DateTime?
  status         servicerequest_status     @default(OPEN)
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime
  proposal       proposal[]
  servicebooking servicebooking[]
  category       category                  @relation(fields: [categoryId], references: [id], map: "ServiceRequest_categoryId_fkey")
  client         client                    @relation(fields: [clientId], references: [id], onDelete: Cascade, map: "ServiceRequest_clientId_fkey")

  @@index([categoryId], map: "ServiceRequest_categoryId_fkey")
  @@index([clientId], map: "ServiceRequest_clientId_fkey")
}

model skill {
  id              String            @id
  name            String
  serviceprovider serviceprovider[] @relation("serviceprovidertoskill")
  service         service[]         @relation("servicetoskill")
}

model timerecord {
  id               String         @id
  serviceBookingId String
  startTime        DateTime
  endTime          DateTime?
  duration         Float?
  notes            String?        @db.Text
  createdAt        DateTime       @default(now())
  updatedAt        DateTime
  latitude         Float?
  longitude        Float?
  servicebooking   servicebooking @relation(fields: [serviceBookingId], references: [id], onDelete: Cascade, map: "TimeRecord_serviceBookingId_fkey")

  @@index([serviceBookingId], map: "TimeRecord_serviceBookingId_fkey")
}

model user {
  id                                      String               @id
  email                                   String               @unique(map: "User_email_key")
  password                                String
  firstName                               String
  lastName                                String
  profilePicture                          String?
  phone                                   String?
  createdAt                               DateTime             @default(now())
  updatedAt                               DateTime
  role                                    user_role            @default(CLIENT)
  isVerified                              Boolean              @default(false)
  isActive                                Boolean              @default(true)
  client                                  client?
  conversation_conversation_user1IdTouser conversation[]       @relation("conversation_user1IdTouser")
  conversation_conversation_user2IdTouser conversation[]       @relation("conversation_user2IdTouser")
  message_message_receiverIdTouser        message[]            @relation("message_receiverIdTouser")
  message_message_senderIdTouser          message[]            @relation("message_senderIdTouser")
  notification                            notification[]
  resetpasswordtoken                      resetpasswordtoken[]
  review_review_giverIdTouser             review[]             @relation("review_giverIdTouser")
  review_review_receiverIdTouser          review[]             @relation("review_receiverIdTouser")
  serviceprovider                         serviceprovider?
  verificationtoken                       verificationtoken[]
}

model verificationtoken {
  id        String                 @id
  userId    String
  token     String                 @unique(map: "VerificationToken_token_key")
  type      verificationtoken_type
  expiresAt DateTime
  createdAt DateTime               @default(now())
  isUsed    Boolean                @default(false)
  user      user                   @relation(fields: [userId], references: [id], onDelete: Cascade, map: "VerificationToken_userId_fkey")

  @@index([userId], map: "VerificationToken_userId_fkey")
}

model workexperience {
  id                String          @id
  serviceProviderId String
  company           String
  position          String
  startDate         DateTime
  endDate           DateTime?
  description       String?         @db.Text
  isCurrentPosition Boolean         @default(false)
  serviceprovider   serviceprovider @relation(fields: [serviceProviderId], references: [id], onDelete: Cascade, map: "WorkExperience_serviceProviderId_fkey")

  @@index([serviceProviderId], map: "WorkExperience_serviceProviderId_fkey")
}

enum address_type {
  HOME
  WORK
  OTHER
}

enum notification_type {
  BOOKING_REQUEST
  BOOKING_CONFIRMED
  BOOKING_CANCELLED
  PAYMENT_RECEIVED
  NEW_MESSAGE
  REVIEW_RECEIVED
  SERVICE_COMPLETED
  CONTRACT_SIGNED
  GENERAL
}

enum document_type {
  ID
  CERTIFICATE
  LICENSE
  RESUME
  OTHER
}

enum payment_status {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum verificationtoken_type {
  EMAIL
  PHONE
  IDENTITY
  TWO_FACTOR
}

enum contract_paymentType {
  HOURLY
  FIXED
  DAILY
  SESSION
}

enum proposal_pricingType {
  HOURLY
  FIXED
  DAILY
  SESSION
}

enum service_pricingType {
  HOURLY
  FIXED
  DAILY
  SESSION
}

enum servicerequest_budgetType {
  HOURLY
  FIXED
  DAILY
  SESSION
}

enum servicebooking_status {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DISPUTED
}

enum proposal_status {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum user_role {
  ADMIN
  CLIENT
  PROVIDER
}

enum servicerequest_status {
  OPEN
  CLOSED
  CANCELLED
  ASSIGNED
}
